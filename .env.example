# Copy to .env (gitignored) on your own computer and fill in. Without keys the workbench runs in demo mode.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Tencent Cloud ASR (语音识别 录音文件识别)
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_ENGINE=16k_zh_en_2.0

# Optional
YOUTUBE_API_KEY=
# STUDIO_DATA_DIR=D:\video-studio-data
# STUDIO_MOCK=1          # force demo mode even with keys
# LOOP_MAX_ITER=3
# LOOP_PASS_SCORE=7.0
